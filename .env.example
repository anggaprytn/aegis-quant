APP_NAME=aegis-quant-api
APP_ENV=development
API_BIND_ADDR=0.0.0.0:3000
DATABASE_URL=postgres://aegis:aegis@postgres:5432/aegis_quant
DATABASE_MAX_CONNECTIONS=5
MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_STALE_THRESHOLD_SECONDS=10
