AEGIS_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3101,http://127.0.0.1:3101,https://aegis.anggaprytn.com
POSTGRES_DB=aegis_quant
POSTGRES_USER=aegis
POSTGRES_PASSWORD=RANDOM_PASSWORD_HERE
APP_NAME=aegis-quant-api
APP_ENV=development
API_BIND_ADDR=0.0.0.0:3000
DATABASE_URL=postgres://aegis:aegis@postgres:5432/aegis_quant
TEST_DATABASE_URL=postgres://aegis:aegis@127.0.0.1:5432/aegis_quant_test
DATABASE_MAX_CONNECTIONS=5
AEGIS_AUTH_DISABLED=false
AEGIS_JWT_SECRET=replace-with-a-long-random-local-dev-secret
AEGIS_ACCESS_TOKEN_TTL_SECONDS=900
AEGIS_REFRESH_TOKEN_TTL_SECONDS=86400
AEGIS_COOKIE_SECURE=false
AEGIS_PROTECT_METRICS=false
AEGIS_BOOTSTRAP_OWNER_EMAIL=owner@example.com
AEGIS_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-12-char-min-password
AEGIS_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3101,http://127.0.0.1:3101
AEGIS_API_BASE_URL=http://127.0.0.1:3000
MARKET_EXCHANGE=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_STALE_THRESHOLD_SECONDS=10
# Public market-data endpoints only. Authenticated exchange actions remain testnet-only in v0.1.
BINANCE_WS_BASE_URL=wss://stream.binance.com:443
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_REST_FALLBACK_BASE_URLS=https://data-api.binance.vision,https://api1.binance.com,https://api2.binance.com,https://api3.binance.com,https://api4.binance.com
BINANCE_TESTNET_REST_BASE_URL=https://testnet.binance.vision
BINANCE_TESTNET_WS_BASE_URL=wss://stream.testnet.binance.vision/ws
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_RECV_WINDOW_MS=5000
BINANCE_TESTNET_PRIVATE_STREAM_STALE_THRESHOLD_SECONDS=90
BINANCE_TESTNET_PRIVATE_STREAM_KEEPALIVE_SECONDS=1800
BINANCE_TESTNET_PRIVATE_STREAM_RECONNECT_DELAY_SECONDS=5
SHADOW_OBSERVATION_ONLY=true
STRATEGY_DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
STRATEGY_DEFAULT_TIMEFRAME=1m
STRATEGY_DEFAULT_NOTIONAL=100000
MOMENTUM_LOOKBACK_CANDLES=3
BREAKOUT_LOOKBACK_CANDLES=20
RUST_LOG=info,axum=info,tower_http=info
SCHEDULED_RESEARCH_RUNNER_ENABLED=false
SCHEDULED_RESEARCH_RUNNER_INTERVAL_SECONDS=60
SCHEDULED_RESEARCH_DISABLED_SLEEP_SECONDS=300
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3100
